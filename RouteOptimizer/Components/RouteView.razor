@if (Result is null)
{
    <div class="empty-state"><h2>Маршрут ещё не рассчитан</h2><p>Введите матрицу или загрузите пример, затем нажмите «Рассчитать маршрут». Здесь появятся переходы, их стоимость и подтверждение оптимальности.</p></div>
}
else
{
    <div class="result-status @StateClass" role="status"><MudIcon Icon="@StateIcon" /><div><h2>@DisplayText.Status(Result.Status)</h2><p>@StateExplanation</p></div></div>
    @if (Result.StopReason != StopReason.None) { <p class="explanation-note">@DisplayText.Stop(Result.StopReason) Для нового поиска нажмите «Рассчитать заново».</p> }
    @if (Result.BestRoute is { } route && Problem is not null)
    {
        <div class="result-layout"><section class="route-transitions"><div class="section-title-row"><h3>@(Result.Status == SearchStatus.Optimal ? "Оптимальный маршрут" : "Лучший найденный маршрут")</h3><span class="route-cost">@route.Cost <span>мин</span></span></div>
            <p class="route-path">@string.Join(" → ", route.Vertices.Select(v => (v + 1).ToString()))</p>
            <table class="data-table route-table"><thead><tr><th scope="col">Переход</th><th scope="col">Откуда</th><th scope="col">Куда</th><th scope="col" class="numeric">Стоимость, мин</th></tr></thead><tbody>
                @for (var i = 0; i < route.Vertices.Count - 1; i++)
                {
                    var index = i; var from = route.Vertices[i]; var to = route.Vertices[i + 1];
                    <tr class="@(_selectedEdge == index ? "selected-transition" : "")" @onclick="() => SelectEdge(index)"><td><button type="button" class="transition-button" aria-pressed="@(_selectedEdge == index ? "true" : "false")" aria-label="@($"Переход {from + 1} → {to + 1}: {Problem.Names[from]} → {Problem.Names[to]}, {Problem[from, to]} мин")" @onclick="() => SelectEdge(index)">@(from + 1) → @(to + 1)</button></td><td>@Problem.Names[from]</td><td>@Problem.Names[to]</td><td class="numeric">@Problem[from, to]</td></tr>
                }
            </tbody><tfoot><tr><th colspan="3" scope="row">Общая стоимость замкнутого маршрута</th><td class="numeric"><strong>@route.Cost</strong></td></tr></tfoot></table>
        </section><section class="route-diagram"><h3>Схема обхода</h3>
            <svg viewBox="0 0 400 320" class="route-svg" role="group" aria-label="Направленная схема найденного маршрута. Выберите стрелку для просмотра стоимости">
                <defs><marker id="route-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" /></marker></defs>
                @for (var i = 0; i < route.Vertices.Count - 1; i++)
                {
                    var index = i; var from = route.Vertices[i]; var to = route.Vertices[i + 1];
                    var a = Point(from); var b = Point(to);
                    var dx = b.X - a.X; var dy = b.Y - a.Y; var length = Math.Sqrt(dx * dx + dy * dy);
                    <g class="route-edge @(_selectedEdge == index ? "selected-edge" : "")" role="button" tabindex="0" aria-pressed="@(_selectedEdge == index ? "true" : "false")" aria-label="@($"Переход {from + 1} → {to + 1}, {Problem[from, to]} мин")" @onclick="() => SelectEdge(index)" @onkeydown="e => EdgeKey(e, index)">
                        <title>@Problem.Names[from] → @Problem.Names[to]: @Problem[from, to] мин</title>
                        <line class="edge-hit" x1="@F(a.X + dx / length * 22)" y1="@F(a.Y + dy / length * 22)" x2="@F(b.X - dx / length * 28)" y2="@F(b.Y - dy / length * 28)" />
                        <line class="edge-stroke" x1="@F(a.X + dx / length * 22)" y1="@F(a.Y + dy / length * 22)" x2="@F(b.X - dx / length * 28)" y2="@F(b.Y - dy / length * 28)" marker-end="url(#route-arrow)" />
                    </g>
                }
                @for (var i = 0; i < Problem.Count; i++)
                {
                    var point = Point(i);
                    <g tabindex="0" role="img" aria-label="@($"Объект {i + 1}: {Problem.Names[i]}")"><title>@(i + 1). @Problem.Names[i]</title><circle cx="@F(point.X)" cy="@F(point.Y)" r="20" class="@(i == Problem.Start ? "start-node" : "")" /><text x="@F(point.X)" y="@F(point.Y + 5)" text-anchor="middle" class="@(i == Problem.Start ? "start-node-label" : "")">@(i + 1)</text></g>
                }
            </svg>
            <div class="selected-edge-detail" aria-live="polite">
                @if (_selectedEdge >= 0 && _selectedEdge < route.Vertices.Count - 1)
                {
                    var from = route.Vertices[_selectedEdge]; var to = route.Vertices[_selectedEdge + 1];
                    <strong>@(from + 1) → @(to + 1) · @Problem[from, to] мин</strong><span>@Problem.Names[from] → @Problem.Names[to]</span>
                }
                else { <span>Выберите стрелку на схеме или переход в таблице.</span> }
            </div><p class="supporting">Начало и конец — @(Problem.Start + 1). @Problem.Names[Problem.Start]. Схема условная: длины линий не задают стоимость.</p>
        </section></div>
    }
    <dl class="bounds-grid"><div><dt>Нижняя оценка</dt><dd>@(Result.LowerBound?.ToString() ?? "—") <span>мин</span></dd></div>
        <div><dt>Верхняя оценка</dt><dd>@(Result.BestRoute?.Cost.ToString() ?? "Нет маршрута")@if (Result.BestRoute is not null) { <span> мин</span> }</dd></div>
        <div><dt>Разрыв между границами</dt><dd>@(Result.RelativeGapPercent is { } gap ? $"{gap:F2}%" : Result.AbsoluteGap is { } absolute ? $"{absolute} мин" : "Не определён")</dd></div></dl>
    @if (Result.Status == SearchStatus.Optimal) { <p class="proof-note">Все перспективные ветви закрыты. @(Result.LowerBound is { } lower ? $"Нижняя оценка {lower} совпадает со стоимостью найденного маршрута." : "") Оптимальность подтверждена точным поиском.</p> }
}
@code {
    [Parameter] public TspProblem? Problem { get; set; }
    [Parameter] public SolveResult? Result { get; set; }
    private int _selectedEdge = -1;
    private object? _displayedRoute;
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_displayedRoute, Result?.BestRoute)) { _selectedEdge = -1; _displayedRoute = Result?.BestRoute; }
    }
    private void SelectEdge(int index) => _selectedEdge = index;
    private void EdgeKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, int index)
    {
        if (e.Key is "Enter" or " ") SelectEdge(index);
    }
    private string StateClass => Result?.Status switch { SearchStatus.Optimal => "state-success", SearchStatus.Stopped => "state-warning", SearchStatus.Infeasible => "state-danger", _ => "state-neutral" };
    private string StateIcon => Result?.Status switch { SearchStatus.Optimal => Icons.Material.Outlined.CheckCircle, SearchStatus.Stopped => Icons.Material.Outlined.PauseCircle, SearchStatus.Infeasible => Icons.Material.Outlined.Block, _ => Icons.Material.Outlined.HourglassTop };
    private string StateExplanation => Result?.Status switch
    {
        SearchStatus.Optimal => "Найден допустимый замкнутый маршрут минимальной стоимости.",
        SearchStatus.Infeasible => "При заданных запретах единого маршрута через все объекты не существует. Проверьте исходную матрицу.",
        SearchStatus.Stopped => Result.BestRoute is null ? "До остановки допустимый маршрут не найден. Это не доказывает отсутствие решения." : "Сохранён лучший найденный маршрут. Поиск остановлен до подтверждения оптимальности.",
        _ => Result?.BestRoute is null ? "Допустимый маршрут ещё не найден. Продолжайте поиск или выполняйте шаги." : "Найден допустимый маршрут. Поиск лучшего решения и доказательство продолжаются."
    };
    private (double X, double Y) Point(int vertex) { var angle = vertex * 2 * Math.PI / Problem!.Count - Math.PI / 2; return (200 + 125 * Math.Cos(angle), 155 + 125 * Math.Sin(angle)); }
    private static string F(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
