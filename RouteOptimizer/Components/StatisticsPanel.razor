@if (Result is not null)
{
    <section class="search-statistics"><div class="section-title-row"><h3>Статистика поиска</h3><span>Активное время: <strong>@Result.Statistics.Elapsed.TotalMilliseconds.ToString("F3") мс</strong></span></div>
        <dl class="statistics-grid"><div><dt>Создано узлов</dt><dd>@Result.Statistics.Created</dd></div><div><dt>Обработано</dt><dd>@Result.Statistics.Processed</dd></div><div><dt>Отсечено по оценке</dt><dd>@Result.Statistics.PrunedByBound</dd></div><div><dt>Недопустимых</dt><dd>@Result.Statistics.Infeasible</dd></div><div><dt>Открыто сейчас</dt><dd>@Result.Statistics.Open</dd></div><div><dt>Максимум открытых</dt><dd>@Result.Statistics.MaxOpen</dd></div></dl>
    </section>
}
@code { [Parameter] public SolveResult? Result { get; set; } }
