@inherits LayoutComponentBase
<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<header class="site-header">
    <a class="brand" href="./" aria-label="RouteOptimizer — к задаче"><svg width="29" height="29" viewBox="0 0 29 29" aria-hidden="true"><path d="M6 7 L22 14 L8 23 Z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="6" cy="7" r="3"/><circle cx="22" cy="14" r="3"/><circle cx="8" cy="23" r="3"/></svg>RouteOptimizer</a>
    <span class="header-caption">Метод ветвей и границ</span>
    <span class="header-context">Курсовая работа · алгоритм Литтла</span>
</header>
<main id="main-content" class="app-content">@Body</main>
<footer class="site-footer">Все вычисления выполняются в браузере. Данные учебных примеров условные.</footer>
@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#171c24", Secondary = "#1d5fbf", Background = "#f2f4f7", Surface = "#ffffff", TextPrimary = "#18212f", TextSecondary = "#536074", Success = "#236746", Warning = "#855211", Error = "#a42532" },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px" },
        Typography = new Typography { Default = new DefaultTypography { FontFamily = new[] { "Golos Text", "Segoe UI", "sans-serif" }, FontSize = "0.9375rem" } }
    };
}
